{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "nextjedi": {
      "source": {
        "source": "github",
        "repo": "nextjedi/platform"
      }
    }
  },
  "enabledPlugins": {
    "nextjedi-core@nextjedi": true,
    "nextjedi-kmp@nextjedi": true
  },
  "env": {
    "NEXTJEDI_PRODUCT": "mindful-sports"
  },
  "permissions": {
    "allow": [
      "Bash(make setup)",
      "Bash(make verify)",
      "Bash(make lint)",
      "Bash(make test)",
      "Bash(make build)",
      "Bash(make format)",
      "Bash(make e2e)",
      "Bash(make help)",
      "Bash(./gradlew *)",
      "Bash(sh ./gradlew *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr checks*)",
      "Bash(gh pr diff*)",
      "Bash(gh run list*)",
      "Bash(gh run view*)",
      "Bash(adb devices)",
      "Bash(adb logcat*)"
    ],
    "deny": [
      "Read(./local.properties)",
      "Read(./keystore.properties)",
      "Read(./.env)",
      "Read(./iosApp/Configuration/Secrets.xcconfig)",
      "Read(./**/*.jks)",
      "Read(./**/*.keystore)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push upstream*)"
    ]
  }
}
